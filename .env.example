# Prisma — ABSOLUTE path to the local SQLite database file.
# The app and the db:push / db:generate scripts both read this. The
# `db:push` and `db:generate` npm scripts override it inline with
# `DATABASE_URL="$(pwd)/db/custom.db"` so you can run them from anywhere.
DATABASE_URL=file:/home/z/my-project/apps/19-personal-crm-ai-memory/db/custom.db

# ---- LLM (optional) ----
# When unset, the app falls back to a deterministic MockProvider so the UI is
# fully demoable offline (follow-up drafts + recap narrative). Set to "1" to
# force the mock even when the SDK config is present.
CRM_DISABLE_LLM=

# ---- Embeddings (optional) ----
# If set, the embeddings provider calls out to an OpenAI-compatible endpoint.
# Otherwise a deterministic hashing embedder is used (zero network, zero cost).
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small
